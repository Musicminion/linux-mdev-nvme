config NVME_MDEV_VFIO
	tristate "NVMe mediated VFIO virtual controller (EXPERIMENTAL)"
	depends on NVME_TARGET && VFIO && 64BIT
	select VFIO_MDEV
	select VHOST_TASK
	help
	  A virtual NVMe PCIe controller for guests, as a VFIO mediated
	  device, whose commands are executed by the NVMe target (nvmet):
	  the guest uses its own, unmodified NVMe driver and sees the
	  namespaces of an nvmet subsystem, backed by block devices (e.g.
	  partitions of an NVMe drive) or files.  A polling thread, which
	  belongs to the process using the device (QEMU), hands the guest's
	  commands to nvmet.  The instances use nvmet ports of type "pci".

	  If unsure, say N.
